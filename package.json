{
  "name": "guia-hoteles",
  "version": "1.0.0",
  "description": "Nuestro primer proyecto de Nodejs",
  "homepage": "https://bitbucket.org/adarwin/guia-hoteles#readme",
  "bugs": {
    "url": "https://bitbucket.org/adarwin/guia-hoteles/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://adarwin-admin@bitbucket.org/adarwin/guia-hoteles.git"
  },
  "license": "ISC",
  "author": "Darwin Fernando Acosta",
  "type": "commonjs",
  "main": "index.html",
  "scripts": {
    "dev": "lite-server",
    "test": "echo \"Error: no test specified\" && exit 1",
    "scss": "sass css:css",
    "watch:scss": "onchange \"css/*.scss\" -- npm run scss",
    "start": "concurrently \"npm run watch:scss\" \"npm run dev\"",
    "clean": "rimraf dist",
    "copyfonts": "copyfiles -u 1 node_modules/open-iconic/font/fonts/* dist/fonts",
    "imagemin": "imagemin images/* --out-dir dist/images",
    "usemin": "usemin index.html -d dist --htmlmin -o dist/index.html && usemin about.html -d dist --htmlmin -o dist/about.html && usemin precios.html -d dist --htmlmin -o dist/precios.html && usemin contacto.html -d dist --htmlmin -o dist/contacto.html",
    "build": "npm run clean && npm run scss && npm run imagemin && npm run copyfonts && npm run usemin"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "copyfiles": "^2.4.1",
    "cssmin": "^0.4.3",
    "htmlmin": "^0.0.7",
    "imagemin-cli": "^8.0.0",
    "lite-server": "^2.6.1",
    "onchange": "^7.1.0",
    "rimraf": "^6.1.3",
    "sass": "^1.106.0",
    "uglify-js": "^3.19.3",
    "usemin-cli": "^0.6.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "jquery": "^4.0.0",
    "open-iconic": "^1.1.1",
    "popper.js": "^1.16.1"
  }
}